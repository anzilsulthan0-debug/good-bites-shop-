# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign session tokens and encrypt shop credentials.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_LONG_SECRET"

# Optional initial admin credentials (defaults to admin / admin123 if unset)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Optional live URL for Capacitor Android/iOS builds so mobile apps load live updates directly
# CAPACITOR_SERVER_URL="https://your-good-bites-domain.com"
